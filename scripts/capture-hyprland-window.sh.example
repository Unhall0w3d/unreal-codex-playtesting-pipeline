#!/usr/bin/env bash
set -euo pipefail
umask 077

# Capture one newly-created rendered window on Hyprland 0.55+ without changing
# the caller's active workspace. This is a reference adapter, not a game
# protocol: the game must write the requested readiness marker to stdout/stderr.

usage() {
  cat >&2 <<'USAGE'
Usage: capture-hyprland-window.sh.example \
  --editor /path/to/game-launcher \
  --project /path/to/Game.uproject \
  --output /path/to/capture.png \
  --workspace 3 \
  --ready-marker READY_MARKER \
  [--timeout-seconds 120] [--capture-timeout-seconds 15] \
  [--window-regex REGEX] [--initial-class-regex REGEX] \
  [--initial-title-regex REGEX] [-- extra game arguments]

The target workspace must already be visible on a dedicated monitor/workspace.
On Hyprland 0.56+, --initial-class-regex enables temporary map-time placement
so splash/replacement clients cannot flash on the caller's active workspace.
USAGE
  exit 2
}

editor=""
project=""
output=""
workspace=""
ready_marker=""
timeout_seconds=120
capture_timeout_seconds=15
window_regex=""
initial_class_regex=""
initial_title_regex=""
extra_args=()

while (($#)); do
  case "$1" in
    --editor) [[ $# -ge 2 ]] || usage; editor=$2; shift 2 ;;
    --project) [[ $# -ge 2 ]] || usage; project=$2; shift 2 ;;
    --output) [[ $# -ge 2 ]] || usage; output=$2; shift 2 ;;
    --workspace) [[ $# -ge 2 ]] || usage; workspace=$2; shift 2 ;;
    --ready-marker) [[ $# -ge 2 ]] || usage; ready_marker=$2; shift 2 ;;
    --timeout-seconds) [[ $# -ge 2 ]] || usage; timeout_seconds=$2; shift 2 ;;
    --capture-timeout-seconds) [[ $# -ge 2 ]] || usage; capture_timeout_seconds=$2; shift 2 ;;
    --window-regex) [[ $# -ge 2 ]] || usage; window_regex=$2; shift 2 ;;
    --initial-class-regex) [[ $# -ge 2 ]] || usage; initial_class_regex=$2; shift 2 ;;
    --initial-title-regex) [[ $# -ge 2 ]] || usage; initial_title_regex=$2; shift 2 ;;
    --) shift; extra_args+=("$@"); break ;;
    -h|--help) usage ;;
    *) echo "Unknown argument: $1" >&2; usage ;;
  esac
done

[[ -n "$editor" && -x "$editor" ]] || { echo "--editor must name an executable" >&2; exit 2; }
[[ -f "$project" ]] || { echo "--project must name an existing project file" >&2; exit 2; }
[[ -n "$output" ]] || { echo "--output is required" >&2; exit 2; }
[[ "$workspace" =~ ^[0-9]+$ ]] || { echo "--workspace must be a numeric Hyprland workspace" >&2; exit 2; }
[[ -n "$ready_marker" ]] || { echo "--ready-marker is required" >&2; exit 2; }
[[ "$timeout_seconds" =~ ^[1-9][0-9]*$ ]] || { echo "--timeout-seconds must be a positive integer" >&2; exit 2; }
[[ "$capture_timeout_seconds" =~ ^[1-9][0-9]*$ ]] || { echo "--capture-timeout-seconds must be a positive integer" >&2; exit 2; }
[[ "$initial_class_regex" != *"]]"* && "$initial_title_regex" != *"]]"* ]] || {
  echo "Initial window regexes must not contain the Lua long-string terminator ]]" >&2
  exit 2
}

command -v hyprctl >/dev/null || { echo "hyprctl is required" >&2; exit 1; }
command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
command -v grim >/dev/null || { echo "grim is required" >&2; exit 1; }
command -v timeout >/dev/null || { echo "timeout is required" >&2; exit 1; }

output_dir="$(dirname -- "$output")"
mkdir -p -- "$output_dir"
log_path="$output_dir/capture-$$.log"

clients_json() { hyprctl clients -j; }
addresses() { clients_json | jq -r '.[].address' | sort; }

before_addresses="$(addresses)"
editor_pid=""
capture_rule_name="capture-window-$$"
capture_rule_armed=""

cleanup() {
  local status=$?
  trap - EXIT INT TERM
  if [[ -n "$editor_pid" ]] && kill -0 "$editor_pid" 2>/dev/null; then
    kill -TERM "$editor_pid" 2>/dev/null || true
    for _ in {1..40}; do
      kill -0 "$editor_pid" 2>/dev/null || break
      sleep 0.1
    done
    kill -KILL "$editor_pid" 2>/dev/null || true
    wait "$editor_pid" 2>/dev/null || true
  fi
  if [[ -n "$capture_rule_armed" ]]; then
    hyprctl eval "local r = hl.window_rule({ name = [[$capture_rule_name]] }); r:set_enabled(false)" >/dev/null 2>&1 || true
  fi
  exit "$status"
}
trap cleanup EXIT INT TERM

target_monitor="$(hyprctl workspaces -j | jq -r --arg workspace "$workspace" \
  '.[] | select((.id | tostring) == $workspace) | .monitor' | head -n 1)"
[[ -n "$target_monitor" ]] || {
  echo "Workspace $workspace is not currently assigned to a visible monitor" >&2
  exit 1
}

# Unreal and other native launchers may destroy a splash client and create a
# replacement top-level window. Moving the first mapped client is too late: one
# frame can flash on the focused workspace and the application may take input.
# A temporary, narrowly matched rule places every matching client at map time.
if [[ -n "$initial_class_regex" ]]; then
  title_match=""
  if [[ -n "$initial_title_regex" ]]; then
    title_match=", initial_title = [[$initial_title_regex]]"
  fi
  hyprctl eval "local r = hl.window_rule({ name = [[$capture_rule_name]], enabled = true, match = { initial_class = [[$initial_class_regex]]$title_match }, workspace = [[$workspace]], monitor = [[$target_monitor]], no_initial_focus = true }); r:set_enabled(true)" >/dev/null
  capture_rule_armed=1
fi

"$editor" "$project" "${extra_args[@]}" >"$log_path" 2>&1 &
editor_pid=$!

deadline=$((SECONDS + timeout_seconds))
new_address=""
while ((SECONDS < deadline)); do
  if grep -aFq -- "$ready_marker" "$log_path" 2>/dev/null; then
    mapfile -t candidates < <(comm -23 <(addresses) <(printf '%s\n' "$before_addresses" | sort))
    if [[ -n "$window_regex" ]]; then
      mapfile -t candidates < <(
        clients_json | jq -r --argjson candidates "$(printf '%s\n' "${candidates[@]}" | jq -R -s 'split("\n") | map(select(length > 0))')" \
          --arg pattern "$window_regex" \
          '.[] | select(.address as $a | ($candidates | index($a))) | select((.class + " " + .title) | test($pattern)) | .address'
      )
    fi
    if ((${#candidates[@]} == 1)); then
      new_address=${candidates[0]}
      break
    fi
  fi
  sleep 0.2
done

[[ -n "$new_address" ]] || {
  echo "Timed out waiting for one new window with readiness marker: $ready_marker" >&2
  exit 1
}

# The map-time rule is preferred. This move is a fallback for Hyprland 0.55 or
# callers that omit --initial-class-regex; follow=false preserves user focus.
if [[ -z "$capture_rule_armed" ]]; then
  hyprctl eval "hl.dispatch(hl.dsp.window.move({ workspace = \"$workspace\", follow = false, window = \"address:$new_address\" }))" >/dev/null
fi

geometry=""
while ((SECONDS < deadline)); do
  geometry="$(clients_json | jq -r --arg address "$new_address" \
    '.[] | select(.address == $address) | "\(.at[0]) \(.at[1]) \(.size[0]) \(.size[1])"' | head -n 1)"
  [[ -n "$geometry" ]] && break
  sleep 0.2
done

read -r x y width height <<<"$geometry"
[[ "$x" =~ ^-?[0-9]+$ && "$y" =~ ^-?[0-9]+$ && "$width" =~ ^[1-9][0-9]*$ && "$height" =~ ^[1-9][0-9]*$ ]] || {
  echo "Could not resolve a valid geometry for window address $new_address" >&2
  exit 1
}

initial_workspace="$(clients_json | jq -r --arg address "$new_address" \
  '.[] | select(.address == $address) | .workspace.name' | head -n 1)"
[[ "$initial_workspace" == "$workspace" ]] || {
  echo "Window mapped on workspace $initial_workspace, expected $workspace" >&2
  exit 1
}

timeout --signal=TERM "$capture_timeout_seconds" \
  grim -g "${x},${y} ${width}x${height}" "$output"
[[ -s "$output" ]] || { echo "Capture is empty: $output" >&2; exit 1; }
echo "Captured $output from window address $new_address (${width}x${height})"
